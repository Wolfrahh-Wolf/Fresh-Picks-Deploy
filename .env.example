# Fresh Picks - Environment Variables

# Flask
APP_SECRET_KEY=your-secret-key-here-change-in-production

# Database (PostgreSQL via Supabase/Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname

# Cache (Redis) - REQUIRED
REDIS_URL=redis://default:your-redis-password@redis-host:6379/0

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP (SendGrid or Gmail)
SMTP_EMAIL=your-email@example.com
SMTP_APP_PASSWORD=your-email-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SENDER_NAME=FreshPicks

# SendGrid API Key (for PDF receipts)
SENDGRID_API_KEY=your-sendgrid-api-key

# Flask
FLASK_DEBUG=false

# OTP
OTP_TTL_MINUTES=10
